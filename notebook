Bulan', y='TPK', palette='coolwarm', order=month_order)\n","plt.title('Rata-rata TPK Berdasarkan Bulan')\n","plt.xlabel('Bulan')\n","plt.ylabel('Rata-rata TPK (%)')\n","plt.xticks(rotation=45, ha='right')\n","plt.tight_layout()\n","plt.savefig('tpk_tertinggi_terendah_bulan.png')\n","plt.close()"],"metadata":{"id":"sMlZ6kXv_cV0"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# Pertanyaan 7: Bagaimana korelasi antara jumlah WNA dan WNI dengan TPK hotel di Provinsi Lampung?\n","# Pertanyaan 12: Apakah peningkatan jumlah tamu WNA atau WNI lebih signifikan dalam meningkatkan TPK?\n","print(\"\\n--- Jawaban Pertanyaan 7 & 12: Korelasi Tamu (WNA/WNI) dengan TPK ---\")\n","# Menghitung korelasi\n","# Pastikan kolom WNA/WNI yang digunakan relevan, di sini saya pakai 'wna_in/jml_tamu_asing' dan 'wni_in/jml_tamu_nusantara'\n","# Asumsikan bahwa nilai NaN di TPK, wna_in/jml_tamu_asing, wni_in/jml_tamu_nusantara akan di-drop untuk korelasi\n","correlation_df = gabungan_df[['TPK', 'wna_in/jml_tamu_asing', 'wni_in/jml_tamu_nusantara']].dropna()\n","\n","corr_wna = correlation_df['TPK'].corr(correlation_df['wna_in/jml_tamu_asing'])\n","corr_wni = correlation_df['TPK'].corr(correlation_df['wni_in/jml_tamu_nusantara'])\n","\n","print(f\"Korelasi antara TPK dan jumlah tamu WNA: {corr_wna:.2f}\")\n","print(f\"Korelasi antara TPK dan jumlah tamu WNI: {corr_wni:.2f}\")\n","\n","if abs(corr_wna) > abs(corr_wni):\n","    print(\"Jumlah tamu WNA memiliki korelasi yang lebih kuat (dan mungkin lebih signifikan dalam peningkatan) dengan TPK.\")\n","elif abs(corr_wni) > abs(corr_wna):\n","    print(\"Jumlah tamu WNI memiliki korelasi yang lebih kuat (dan mungkin lebih signifikan dalam peningkatan) dengan TPK.\")\n","else:\n","    print(\"Korelasi antara WNA dan WNI dengan TPK memiliki kekuatan yang serupa.\")\n","\n","# Scatter plot untuk visualisasi korelasi\n","plt.figure(figsize=(14, 6))\n","\n","plt.subplot(1, 2, 1)\n","sns.scatterplot(data=correlation_df, x='wna_in/jml_tamu_asing', y='TPK')\n","plt.title('Scatter Plot TPK vs. Tamu WNA')\n","plt.xlabel('Jumlah Tamu WNA')\n","plt.ylabel('TPK (%)')\n","plt.grid(True)\n","\n","plt.subplot(1, 2, 2)\n","sns.scatterplot(data=correlation_df, x='wni_in/jml_tamu_nusantara', y='TPK')\n","plt.title('Scatter Plot TPK vs. Tamu WNI')\n","plt.xlabel('Jumlah Tamu WNI')\n","plt.ylabel('TPK (%)')\n","plt.grid(True)\n","\n","plt.tight_layout()\n","plt.savefig('korelasi_tpk_wna_wni.png')\n","plt.close()\n","print(\"Grafik scatter plot korelasi TPK dengan WNA dan WNI berhasil dibuat dan disimpan sebagai 'korelasi_tpk_wna_wni.png'.\")"],"metadata":{"id":"B70dGc9pBwmB"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# Pertanyaan 9: Bagaimana tren TPTT hotel di Provinsi Lampung dari tahun 2022 hingga Mei 2025?\n","print(\"\\n--- Jawaban Pertanyaan 9: Tren TPTT Hotel per Bulan ---\")\n","# Filter data dari 2022 hingga Mei 2025\n","df_filtered_q9 = gabungan_df[(gabungan_df['Tahun'] >= 2022) &\n","                             ((gabungan_df['Tahun'] < 2025) |\n","                              ((gabungan_df['Tahun'] == 2025) & (gabungan_df['Bulan_Num'] <= 5)))]\n","\n","tptt_monthly_trend = df_filtered_q9.groupby('Tanggal')['TPTT'].mean().reset_index()\n","\n","# Plotting\n","plt.figure(figsize=(12, 6))\n","sns.lineplot(data=tptt_monthly_trend, x='Tanggal', y='TPTT')\n","plt.title('Tren Rata-rata Tingkat Penghunian Tempat Tidur (TPTT) Hotel di Provinsi Lampung (2022-2025)')\n","plt.xlabel('Tanggal')\n","plt.ylabel('Rata-rata TPTT (%)')\n","plt.grid(True)\n","plt.tight_layout()\n","plt.savefig('tren_tptt_hotel.png')\n","plt.close()\n","print(\"Grafik tren TPTT per bulan berhasil dibuat dan disimpan sebagai 'tren_tptt_hotel.png'.\")\n"],"metadata":{"id":"Zs9z5LxmCUC_"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# Pertanyaan 10: Bagaimana Perbandingan TPTT antara hotel berbintang dan non-bintang?\n","print(\"\\n--- Jawaban Pertanyaan 10: Perbandingan Rata-rata TPTT Hotel Bintang vs Non-Bintang ---\")\n","tptt_by_jenis = gabungan_df.groupby('Jenis')['TPTT'].mean().reset_index()\n","print(tptt_by_jenis)\n","\n","# Plotting\n","plt.figure(figsize=(8, 5))\n","sns.barplot(data=tptt_by_jenis, x='Jenis', y='TPTT', palette='cividis')\n","plt.title('Perbandingan Rata-rata TPTT Hotel Berbintang dan Non-Bintang')\n","plt.xlabel('Jenis Hotel')\n","plt.ylabel('Rata-rata TPTT (%)')\n","plt.tight_layout()\n","plt.savefig('perbandingan_tptt_jenis_hotel.png')\n","plt.close()\n","print(\"Grafik perbandingan TPTT hotel bintang dan non-bintang berhasil dibuat dan disimpan sebagai 'perbandingan_tptt_jenis_hotel.png'.\")"],"metadata":{"id":"JrMMtY5JCZfR"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# Pertanyaan 11: Apakah TPTT memiliki pola musiman yang serupa dengan TPK?\n","print(\"\\n--- Jawaban Pertanyaan 11: Pola Musiman TPTT vs TPK ---\")\n","tpk_monthly_avg_q11 = gabungan_df.groupby('Bulan')['TPK'].mean().reindex(month_order).reset_index()\n","tptt_monthly_avg_q11 = gabungan_df.groupby('Bulan')['TPTT'].mean().reindex(month_order).reset_index()\n","\n","plt.figure(figsize=(14, 7))\n","\n","plt.subplot(1, 2, 1)\n","sns.lineplot(data=tpk_monthly_avg_q11, x='Bulan', y='TPK', marker='o', color='blue')\n","plt.title('Pola Musiman Rata-rata TPK')\n","plt.xlabel('Bulan')\n","plt.ylabel('Rata-rata TPK (%)')\n","plt.xticks(rotation=45, ha='right')\n","plt.grid(True)\n","\n","plt.subplot(1, 2, 2)\n","sns.lineplot(data=tptt_monthly_avg_q11, x='Bulan', y='TPTT', marker='o', color='red')\n","plt.title('Pola Musiman Rata-rata TPTT')\n","plt.xlabel('Bulan')\n","plt.ylabel('Rata-rata TPTT (%)')\n","plt.xticks(rotation=45, ha='right')\n","plt.grid(True)\n","\n","plt.tight_layout()\n","plt.savefig('pola_musiman_tpk_tptt.png')\n","plt.close()\n","\n","print(\"Grafik pola musiman TPK dan TPTT per bulan berhasil dibuat dan disimpan sebagai 'pola_musiman_tpk_tptt.png'.\")\n","print(\"Untuk melihat apakah polanya serupa, bandingkan kedua grafik tersebut secara visual.\")"],"metadata":{"id":"pcCAe0qXCv4s"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# Pertanyaan 13: Bagaimana proporsi tamu WNA dibandingkan dengan WNI dari waktu ke waktu dan pengaruhnya terhadap TPK?\n","print(\"\\n--- Jawaban Pertanyaan 13: Proporsi Tamu WNA vs WNI dari Waktu ke Waktu ---\")\n","\n","# Agregasi data per bulan untuk total tamu WNA dan WNI\n","# Karena TPK dihitung per total gabungan data (Jenis hotel), kita perlu menggabungkan total tamu per bulan\n","monthly_guests_tpk = gabungan_df.groupby('Tanggal').agg(\n","    Total_WNA_In=('wna_in/jml_tamu_asing', 'sum'),\n","    Total_WNI_In=('wni_in/jml_tamu_nusantara', 'sum'),\n","    Avg_TPK=('TPK', 'mean')\n",").reset_index()\n","\n","# Hitung total tamu (WNA + WNI) untuk menghindari pembagian dengan nol jika semua NaN\n","monthly_guests_tpk['Total_Tamu'] = monthly_guests_tpk['Total_WNA_In'] + monthly_guests_tpk['Total_WNI_In']\n","\n","# Hitung proporsi, hindari pembagian dengan nol\n","monthly_guests_tpk['Proporsi_WNA'] = monthly_guests_tpk.apply(\n","    lambda row: row['Total_WNA_In'] / row['Total_Tamu'] if row['Total_Tamu'] > 0 else 0, axis=1\n",")\n","monthly_guests_tpk['Proporsi_WNI'] = monthly_guests_tpk.apply(\n","    lambda row: row['Total_WNI_In'] / row['Total_Tamu'] if row['Total_Tamu'] > 0 else 0, axis=1\n",")\n","\n","# Plotting proporsi WNA vs WNI\n","plt.figure(figsize=(14, 7))\n","\n","plt.subplot(1, 2, 1)\n","sns.lineplot(data=monthly_guests_tpk, x='Tanggal', y='Proporsi_WNA', label='Proporsi WNA', color='orange')\n","sns.lineplot(data=monthly_guests_tpk, x='Tanggal', y='Proporsi_WNI', label='Proporsi WNI', color='purple')\n","plt.title('Proporsi Tamu WNA vs WNI dari Waktu ke Waktu')\n","plt.xlabel('Tanggal')\n","plt.ylabel('Proporsi')\n","plt.legend()\n","plt.grid(True)\n","plt.tight_layout()\n","\n","# Plotting TPK bersamaan dengan proporsi atau sebagai sub-plot terpisah untuk visualisasi pengaruh\n","# Kita sudah punya tren TPK di Q1, ini lebih untuk melihat hubungan visual\n","plt.subplot(1, 2, 2)\n","sns.lineplot(data=monthly_guests_tpk, x='Tanggal', y='Avg_TPK', color='green')\n","plt.title('Rata-rata TPK Hotel')\n","plt.xlabel('Tanggal')\n","plt.ylabel('Rata-rata TPK (%)')\n","plt.grid(True)\n","plt.tight_layout()\n","\n","plt.savefig('proporsi_wna_wni_dan_tpk.png')\n","plt.close()\n","\n","print(\"Grafik proporsi tamu WNA/WNI dan hubungannya dengan TPK berhasil dibuat dan disimpan sebagai 'proporsi_wna_wni_dan_tpk.png'.\")"],"metadata":{"id":"eVrrmzgFDKWW"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# Pertanyaan 8: Apakah ada perbedaan kontribusi antara WNA dan WNI terhadap TPK pada periode tertentu?\n","print(\"\\n--- Jawaban Pertanyaan 8: Perbedaan Kontribusi Tamu WNA dan WNI terhadap TPK ---\")\n","print(\"Berdasarkan hasil korelasi (Pertanyaan 7 & 12) dan visualisasi proporsi tamu (Pertanyaan 13):\")\n","print(f\"- Korelasi TPK dengan WNA: {corr_wna:.2f}\")\n","print(f\"- Korelasi TPK dengan WNI: {corr_wni:.2f}\")\n","print(\"Secara umum, tamu dengan korelasi positif yang lebih tinggi cenderung memiliki 'kontribusi' yang lebih besar terhadap peningkatan TPK.\")\n","print(\"Proporsi tamu (WNA/WNI) dari waktu ke waktu juga bisa menunjukkan periode di mana salah satu jenis tamu lebih dominan dan bagaimana ini bertepatan dengan perubahan TPK.\")\n","print(\"Untuk analisis yang lebih mendalam, dapat dilakukan segmentasi TPK berdasarkan dominasi tamu WNA atau WNI di periode tertentu, atau menggunakan model regresi multi-variabel.\")"],"metadata":{"id":"dhyNVNkDDYIU"},"execution_count":null,"outputs":[]},{"cell_type":"markdown","source":["#Metode Holt-Winters Exponential Smoothing"],"metadata":{"id":"CAre7d_pFI8F"}},{"cell_type":"code","source":["# Agregasi TPK rata-rata per bulan untuk deret waktu\n","tpk_ts = gabungan_df.groupby('Tanggal')['TPK'].mean().dropna()"],"metadata":{"id":"3oH-ZDAkFT_r"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# --- Pertanyaan 5 & 6: Proyeksi TPK dan Pola Musiman/Tren ---\n","print(\"\\n--- Jawaban Pertanyaan 5 & 6: Proyeksi TPK Menggunakan Holt-Winters ---\")\n","\n","# Menentukan periode musiman (12 untuk data bulanan)\n","seasonal_periods = 12\n","\n","# Membangun dan melatih model Holt-Winters untuk TPK\n","# Menggunakan model aditif untuk tren dan musiman, karena TPK adalah persentase dan mungkin tidak tumbuh/turun secara multiplikatif secara eksponensial.\n","fit_tpk = ExponentialSmoothing(tpk_ts, seasonal_periods=seasonal_periods, trend='add', seasonal='add', initialization_method=\"estimated\").fit()\n","\n","# Menentukan periode peramalan\n","last_date = tpk_ts.index.max()\n","forecast_end_date = pd.to_datetime('2026-12-01')\n","forecast_dates = pd.date_range(start=last_date + pd.DateOffset(months=1), end=forecast_end_date, freq='MS')\n","forecast_steps = len(forecast_dates)\n","\n","# Melakukan peramalan\n","forecast_tpk = fit_tpk.forecast(forecast_steps)\n","forecast_tpk.index = forecast_dates\n","\n","# Menggabungkan data historis dan peramalan untuk visualisasi\n","combined_tpk = pd.concat([tpk_ts, forecast_tpk])\n","\n","# Plotting\n","plt.figure(figsize=(15, 7))\n","plt.plot(tpk_ts.index, tpk_ts, label='TPK Historis', color='blue')\n","plt.plot(forecast_tpk.index, forecast_tpk, label='Prediksi TPK (Holt-Winters)', color='red', linestyle='--')\n","plt.title('Prediksi Tingkat Penghunian Kamar (TPK) Hotel di Provinsi Lampung (Holt-Winters)')\n","plt.xlabel('Tanggal')\n","plt.ylabel('TPK (%)')\n","plt.legend()\n","plt.grid(True)\n","plt.tight_layout()\n","plt.savefig('prediksi_tpk_holt_winters.png')\n","plt.close()\n","\n","print(\"Grafik prediksi TPK berhasil dibuat dan disimpan sebagai 'prediksi_tpk_holt_winters.png'.\")\n","\n","# Menyimpan hasil prediksi TPK ke CSV untuk Looker Studio\n","tpk_forecast_df = pd.DataFrame({'Tanggal': forecast_tpk.index, 'Prediksi_TPK': forecast_tpk.values})\n","tpk_forecast_df.to_csv('tpk_forecast_for_looker_studio.csv', index=False)\n","print(\"Hasil prediksi TPK disimpan ke 'tpk_forecast_for_looker_studio.csv' untuk Looker Studio.\")\n","\n","print(\"\\n--- Analisis Pola Musiman dan Tren TPK (Q6) ---\")\n","print(f\"Komponen Tren (aditif): {fit_tpk.params['initial_trend']:.2f}\")\n","print(\"Komponen Musiman (aditif):\")\n","# Perbaikan: Akses komponen musiman satu per satu atau saring berdasarkan nama\n","seasonal_params = {k: v for k, v in fit_tpk.params.items() if k.startswith('seasonal.')}\n","for i in range(seasonal_periods):\n","    key = f'seasonal.{i}'\n","    if key in seasonal_params:\n","        print(f\"  {key}: {seasonal_params[key]:.2f}\")\n","\n","print(\"Anda dapat melihat pola musiman dari nilai komponen musiman di atas. Nilai positif menunjukkan TPK cenderung lebih tinggi dari level dasar pada bulan tersebut, dan sebaliknya.\")\n","print(\"Grafik 'prediksi_tpk_holt_winters.png' juga secara visual menunjukkan tren (garis merah putus-putus) dan pola musiman yang diproyeksikan.\")"],"metadata":{"id":"d_cwARTyFVxH"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# --- Pertanyaan 14: Proyeksi TPTT ---\n","print(\"\\n--- Jawaban Pertanyaan 14: Proyeksi TPTT Menggunakan Holt-Winters ---\")\n","\n","# Agregasi TPTT rata-rata per bulan untuk deret waktu\n","tptt_ts = gabungan_df.groupby('Tanggal')['TPTT'].mean().dropna()\n","\n","# Membangun dan melatih model Holt-Winters untuk TPTT\n","fit_tptt = ExponentialSmoothing(tptt_ts, seasonal_periods=seasonal_periods, trend='add', seasonal='add', initialization_method=\"estimated\").fit()\n","\n","# Melakukan peramalan untuk TPTT\n","forecast_tptt = fit_tptt.forecast(forecast_steps)\n","forecast_tptt.index = forecast_dates\n","\n","# Menggabungkan data historis dan peramalan TPTT untuk visualisasi\n","combined_tptt = pd.concat([tptt_ts, forecast_tptt])\n","\n","# Plotting\n","plt.figure(figsize=(15, 7))\n","plt.plot(tptt_ts.index, tptt_ts, label='TPTT Historis', color='green')\n","plt.plot(forecast_tptt.index, forecast_tptt, label='Prediksi TPTT (Holt-Winters)', color='purple', linestyle='--')\n","plt.title('Prediksi Tingkat Penghunian Tempat Tidur (TPTT) Hotel di Provinsi Lampung (Holt-Winters)')\n","plt.xlabel('Tanggal')\n","plt.ylabel('TPTT (%)')\n","plt.legend()\n","plt.grid(True)\n","plt.tight_layout()\n","plt.savefig('prediksi_tptt_holt_winters.png')\n","plt.close()\n","\n","print(\"Grafik prediksi TPTT berhasil dibuat dan disimpan sebagai 'prediksi_tptt_holt_winters.png'.\")\n","\n","# Menyimpan hasil prediksi TPTT ke CSV untuk Looker Studio\n","tptt_forecast_df = pd.DataFrame({'Tanggal': forecast_tptt.index, 'Prediksi_TPTT': forecast_tptt.values})\n","tptt_forecast_df.to_csv('tptt_forecast_for_looker_studio.csv', index=False)\n","print(\"Hasil prediksi TPTT disimpan ke 'tptt_forecast_for_looker_studio.csv' untuk Looker Studio.\")"],"metadata":{"id":"12-qEoL4HACZ"},"execution_count":null,"outputs":[]},{"cell_type":"markdown","source":["#Kode Gabungan untuk Looker Studio"],"metadata":{"id":"Bpz1NlTqVDzf"}},{"cell_type":"code","source":["# --- 1. Muat Kedua Data ---\n","\n","# Data Historis\n","try:\n","    df_historical_raw = pd.read_csv('2024.csv')\n","except FileNotFoundError:\n","    print(\"Error: '2024.csv' not found. Pastikan file sudah diunggah.\")\n","    exit()\n","\n","# Data Prediksi\n","try:\n","    df_prediction_raw = pd.read_csv('tpk_forecast_for_looker_studio.csv')\n","except FileNotFoundError:\n","    print(\"Error: 'tpk_forecast_for_looker_studio.csv' not found. Pastikan file sudah diunggah.\")\n","    exit()\n","\n","# --- 2. Konversi Kolom Tanggal ke Datetime ---\n","df_historical_raw['Tanggal'] = pd.to_datetime(df_historical_raw['Tanggal'])\n","df_prediction_raw['Tanggal'] = pd.to_datetime(df_prediction_raw['Tanggal'])\n","\n","# --- 3. Pilih Kolom Relevan & Beri Nama Jelas ---\n","\n","# Untuk data historis, agregasi TPK per bulan/tanggal\n","# Karena data historis Anda tampaknya memiliki beberapa entri TPK per Tanggal, kita akan ambil rata-ratanya